{% extends 'dispatch/_layouts/plugin' %}
{% import '_includes/forms' as forms %}

{% set title = 'Delivery & Webhooks'|t('dispatch') %}
{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = true %}

{% block pluginContent %}
    {{ actionInput('dispatch/campaigns/save-settings') }}
    {{ redirectInput('dispatch/settings/transport') }}

    <div id="fields">
        <h2>{{ 'Sending'|t('dispatch') }}</h2>

        <p>
            {{ 'Dispatch sends through Craft’s own email settings. Choose your provider — Amazon SES, Mailgun, Postmark, SendGrid or SMTP — and its API key under {link}, where the key can come from an environment variable.'|t('dispatch', {
                link: tag('a', { href: cpUrl('settings/email'), text: 'Settings → Email'|t('dispatch') }),
            })|raw }}
        </p>

        <hr>

        <h2>{{ 'Bounce & complaint webhooks'|t('dispatch') }}</h2>

        <p class="light">
            {{ 'Point your provider’s bounce and complaint webhook at the URL below. A provider’s webhook is refused until its credential is set here. Use environment variables (e.g. $MAILGUN_WEBHOOK_KEY) — these settings are stored in project config.'|t('dispatch') }}
        </p>

        
        {{ forms.autosuggestField({
            label: 'Mailgun webhook signing key'|t('dispatch'),
            instructions: ('Mailgun → Sending → Webhooks → HTTP webhook signing key. Webhook URL: `' ~ siteUrl('dispatch/webhook/mailgun') ~ '`')|t('dispatch'),
            id: 'mailgunWebhookSigningKey',
            name: 'settings[mailgunWebhookSigningKey]',
            value: settings.mailgunWebhookSigningKey,
            suggestEnvVars: true,
        }) }}

        {% set postmarkUrl = siteUrl('dispatch/webhook/postmark') %}
        <p class="light">{{ 'Postmark sends these as basic auth when they are in the webhook URL:'|t('dispatch') }}
            <code>{{ postmarkUrl|replace('://', '://USER:PASS@') }}</code></p>
        <div class="flex">
            <div class="flex-grow">
                {{ forms.autosuggestField({
                    label: 'Postmark webhook username'|t('dispatch'),
                    id: 'postmarkWebhookUsername',
                    name: 'settings[postmarkWebhookUsername]',
                    value: settings.postmarkWebhookUsername,
                    suggestEnvVars: true,
                }) }}
            </div>
            <div class="flex-grow">
                {{ forms.autosuggestField({
                    label: 'Postmark webhook password'|t('dispatch'),
                    id: 'postmarkWebhookPassword',
                    name: 'settings[postmarkWebhookPassword]',
                    value: settings.postmarkWebhookPassword,
                    suggestEnvVars: true,
                }) }}
            </div>
        </div>

        {{ forms.autosuggestField({
            label: 'SendGrid verification key'|t('dispatch'),
            instructions: ('SendGrid → Mail Settings → Signed Event Webhook → Verification Key (enable signing). Webhook URL: `' ~ siteUrl('dispatch/webhook/sendgrid') ~ '`')|t('dispatch'),
            id: 'sendgridWebhookPublicKey',
            name: 'settings[sendgridWebhookPublicKey]',
            value: settings.sendgridWebhookPublicKey,
            suggestEnvVars: true,
        }) }}

        {{ forms.autosuggestField({
            label: 'Amazon SES topic ARN'|t('dispatch'),
            instructions: ('The SNS topic SES publishes bounces and complaints to. Subscribe `' ~ siteUrl('dispatch/webhook/ses') ~ '` to it over HTTPS; Dispatch confirms the subscription.')|t('dispatch'),
            id: 'sesTopicArn',
            name: 'settings[sesTopicArn]',
            value: settings.sesTopicArn,
            suggestEnvVars: true,
        }) }}

        {% if craft.app.plugins.getPlugin('dispatch').is('pro') %}
            <hr>

            <h2>{{ 'REST API'|t('dispatch') }}</h2>

            {{ forms.autosuggestField({
                label: 'API key'|t('dispatch'),
                instructions: 'Clients send it as `Authorization: Bearer <key>`. Leave empty to turn the API off.'|t('dispatch'),
                id: 'apiKey',
                name: 'settings[apiKey]',
                value: settings.apiKey,
                suggestEnvVars: true,
            }) }}
        {% endif %}
    </div>
{% endblock %}
