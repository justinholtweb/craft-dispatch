{#
 # Dispatch's double opt-in confirmation page. Self-contained: it's a plugin template, so it
 # can't extend the site's layout. Set "Confirmation page template" in Dispatch's sign-up
 # settings to use one of the site's own.
 #
 # state: ask | confirmed | invalid
 #}
{% set listNames = lists|map(l => l.title ?: l.name)|join(', ') %}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {# The token is in this page's URL. The header says the same, but another plugin can add its own. #}
    <meta name="referrer" content="no-referrer">
    <title>{{ (state == 'confirmed' ? 'Subscription confirmed' : (state == 'ask' ? 'Confirm your subscription' : 'Link expired'))|t('dispatch') }} – {{ siteName }}</title>
    <style>
        :root { color-scheme: light dark; --bg: #f5f5f5; --card: #ffffff; --text: #333333; --muted: #666666; --accent: #2563eb; }
        @media (prefers-color-scheme: dark) { :root { --bg: #111827; --card: #1f2937; --text: #e5e7eb; --muted: #9ca3af; --accent: #60a5fa; } }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--text); font: 16px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        main { box-sizing: border-box; width: calc(100% - 32px); max-width: 480px; padding: 40px 32px; border-radius: 8px; background: var(--card); box-shadow: 0 1px 3px rgba(0, 0, 0, .1); text-align: center; }
        h1 { margin: 0 0 12px; font-size: 24px; }
        p { margin: 0 0 20px; color: var(--muted); }
        button { padding: 12px 24px; border: 0; border-radius: 4px; background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
        a { color: var(--accent); }
    </style>
</head>
<body>
<main>
    {% if state == 'ask' %}
        <h1>{{ 'Confirm your subscription'|t('dispatch') }}</h1>
        <p>{{ (listNames ? 'One click and you’re subscribed to {lists}.' : 'One click and you’re subscribed to {siteName}.')|t('dispatch', { lists: listNames, siteName: siteName }) }}</p>
        <form method="post">
            {{ csrfInput() }}
            {{ actionInput('dispatch/signup/confirm') }}
            {{ hiddenInput('code', code) }}
            <button type="submit">{{ 'Confirm'|t('dispatch') }}</button>
        </form>
    {% elseif state == 'confirmed' %}
        <h1>{{ 'You’re subscribed'|t('dispatch') }}</h1>
        <p>{{ 'Thanks for confirming. You’ll hear from {siteName} soon.'|t('dispatch', { siteName: siteName }) }}</p>
        <a href="{{ siteUrl() }}">{{ 'Back to the site'|t('dispatch') }}</a>
    {% else %}
        <h1>{{ 'This link has expired'|t('dispatch') }}</h1>
        <p>{{ 'It may already have been used, or it’s too old. Sign up again to get a new one.'|t('dispatch') }}</p>
        <a href="{{ siteUrl() }}">{{ 'Back to the site'|t('dispatch') }}</a>
    {% endif %}
</main>
</body>
</html>
